# ==============================================================
# Kryptix LLM Chatbot Environment Configuration
# ==============================================================

# LLM Provider: 'gemini' or 'openai'
LLM_PROVIDER=gemini

# Google Gemini API Key (Get free key from https://aistudio.google.com/)
GEMINI_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# OpenAI API Key (Optional, from https://platform.openai.com/api-keys)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Context Window Management Configuration
# Strategy: 'sliding_window' (truncation) or 'summarization' (running summary + window)
CONTEXT_STRATEGY=sliding_window

# Maximum number of recent conversational messages to retain in active context
MAX_CONTEXT_MESSAGES=6

# Server configuration
SERVER_HOST=127.0.0.1
SERVER_PORT=8000
